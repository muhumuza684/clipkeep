{
  "name": "clipkeep-windows",
  "productName": "ClipKeep",
  "version": "1.5.0",
  "description": "A clipboard that keeps everything you copy, understands phone numbers, emails and colours, and finds it all again.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.brytma.clipkeep",
    "productName": "ClipKeep",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "store.js",
      "smart.js",
      "brand.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ClipKeep-Setup.exe"
    },
    "portable": {
      "artifactName": "ClipKeep-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "muhumuza684",
        "repo": "clipkeep"
      }
    ]
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  },
  "author": "Bryt Ma Tech",
  "repository": "github:muhumuza684/clipkeep",
  "homepage": "https://github.com/muhumuza684/clipkeep"
}
